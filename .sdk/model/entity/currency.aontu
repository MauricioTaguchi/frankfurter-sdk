# Entity: currency

main: kit: entity: currency: {

  alias: field: {}

  fields: {
    end_date: {
      fo: "date"
      h: "End Date"
      n: "end_date"
      r: false
      sh: "Latest publication coverage date; use /coverage for queryable pairs"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    iso_code: {
      h: "Iso Code"
      n: "iso_code"
      r: true
      sh: "Currency or accounting unit code"
      t: "`$STRING`"
    }
    iso_numeric: {
      h: "Iso Numeric"
      n: "iso_numeric"
      r: false
      sh: "ISO 4217 numeric code"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Full currency name"
      t: "`$STRING`"
    }
    peg: {
      h: "Peg"
      n: "peg"
      r: false
      sh: "Peg metadata, present only for pegged currencies"
      t: "`$OBJECT`"
    }
    providers: {
      h: "Providers"
      n: "providers"
      r: false
      sh: "Provider keys that publish this currency"
      t: "`$ARRAY`"
    }
    start_date: {
      fo: "date"
      h: "Start Date"
      n: "start_date"
      r: false
      sh: "Earliest publication coverage date; use /coverage for queryable pairs"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    symbol: {
      h: "Symbol"
      n: "symbol"
      r: false
      sh: "Currency symbol"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "currency"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /currencies"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "ECB,TCMB"
                k: "query"
                n: "provider"
                or: "providers"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "scope"
                or: "scope"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/currencies"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "currencies"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /currency/{code}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "USD"
                k: "param"
                n: "id"
                or: "code"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/currency/{code}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              code: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "currency"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
